# Configure locally; never expose this key to the frontend.
GOOGLE_API_KEY=""
DEFAULT_IMAGE_MODEL="gemini-3.1-flash-image"
HOST="0.0.0.0"
PORT=8010
ENVIRONMENT="development"
RENDER_TIMEOUT_SECONDS=240
# Explicit UI/API testing only. No automatic fallback on AI failure.
MOCK_RENDER_ENABLED=false

# true for Google Cloud Agent Platform / Vertex express API keys
GOOGLE_GENAI_USE_VERTEXAI=false
