# Backend Configuration
APP_NAME="BIMAutomation Backend"
ENVIRONMENT="production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="YOUR_SECRET_KEY"
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
FRONTEND_RESET_URL="http://localhost/reset-password"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_SENDER="BIMAutomation <no-reply@example.com>"
SMTP_USE_TLS=True

# SePay Payment Gateway & Banking Configuration
SEPAY_CLIENT_ID="YOUR_SEPAY_CLIENT_ID"
SEPAY_CLIENT_SECRET="YOUR_SEPAY_CLIENT_SECRET"
SEPAY_API_KEY="YOUR_SEPAY_API_KEY"
BANK_CODE=MB
BANK_ACCOUNT="YOUR_ACCOUNT_NUMBER"
BANK_HOLDER="YOUR_ACCOUNT_NAME"

# Frontend Ports
FRONTEND_PORT=80

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN="YOUR_CLOUDFLARE_TUNNEL_TOKEN"

