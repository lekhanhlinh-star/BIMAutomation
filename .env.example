# Backend Configuration
APP_NAME="BIMAutomation Backend"
ENVIRONMENT="production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="YOUR_SECRET_KEY"
LICENSE_HMAC_SECRET="bimauto_telemetry_secure_sign_2026"
# Mount this path on persistent storage. It must match the public key pinned in the add-in.
LICENSE_RSA_PRIVATE_KEY_PATH="/app/data/license_rsa_private.pem"
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
FRONTEND_RESET_URL="http://localhost/reset-password"
# SMTP Email Configuration (Hostinger / Custom)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USERNAME="support@bimautomation.solutions"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_FROM_NAME="BIM Automation"
SMTP_SENDER="BIM Automation <support@bimautomation.solutions>"
SMTP_USE_SSL=True
SMTP_USE_TLS=False

# SePay Payment Gateway & Banking Configuration
SEPAY_CLIENT_ID="YOUR_SEPAY_CLIENT_ID"
SEPAY_CLIENT_SECRET="YOUR_SEPAY_CLIENT_SECRET"
SEPAY_API_KEY="YOUR_SEPAY_API_KEY"
BANK_CODE=MBBank
BANK_ACCOUNT="0911972242"
BANK_HOLDER="LE KHANH LINH"

# Frontend Ports
FRONTEND_PORT=80

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN="YOUR_CLOUDFLARE_TUNNEL_TOKEN"
