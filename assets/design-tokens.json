{
  "name": "BimAutomation Design Tokens",
  "version": "1.0.0",
  "description": "Standardized 3-layer design tokens for BimAutomation / RevitAPP",
  "tokens": {
    "primitive": {
      "color": {
        "blue": {
          "50": "#eff6ff",
          "100": "#dbeafe",
          "200": "#bfdbfe",
          "300": "#93c5fd",
          "400": "#60a5fa",
          "500": "#3b82f6",
          "600": "#2563eb",
          "700": "#1d4ed8",
          "800": "#1e40af",
          "900": "#1e3a8a"
        },
        "cyan": {
          "50": "#ecfeff",
          "100": "#cffafe",
          "200": "#a5f3fc",
          "300": "#67e8f9",
          "400": "#22d3ee",
          "500": "#06b6d4",
          "600": "#0891b2",
          "700": "#0e7490",
          "800": "#155e75",
          "900": "#164e63"
        },
        "slate": {
          "50": "#f8fafc",
          "100": "#f1f5f9",
          "200": "#e2e8f0",
          "300": "#cbd5e1",
          "400": "#94a3b8",
          "500": "#64748b",
          "600": "#475569",
          "700": "#334155",
          "800": "#1e293b",
          "900": "#0f172a",
          "950": "#020617"
        },
        "emerald": {
          "500": "#10b981",
          "600": "#059669"
        },
        "amber": {
          "500": "#f59e0b",
          "600": "#d97706"
        },
        "rose": {
          "500": "#ef4444",
          "600": "#dc2626"
        }
      },
      "font": {
        "sans": "Plus Jakarta Sans, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace"
      },
      "spacing": {
        "0": "0px",
        "1": "0.25rem",
        "2": "0.5rem",
        "3": "0.75rem",
        "4": "1rem",
        "6": "1.5rem",
        "8": "2rem",
        "12": "3rem",
        "16": "4rem",
        "24": "6rem"
      },
      "radii": {
        "none": "0px",
        "sm": "0.25rem",
        "md": "0.375rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "2xl": "1rem",
        "full": "9999px"
      }
    },
    "semantic": {
      "brand": {
        "primary": "{primitive.color.blue.600}",
        "primary-hover": "{primitive.color.blue.700}",
        "accent": "{primitive.color.cyan.500}",
        "accent-glow": "rgba(6, 182, 212, 0.35)",
        "gradient-start": "{primitive.color.blue.600}",
        "gradient-end": "{primitive.color.cyan.500}"
      },
      "surface": {
        "canvas-dark": "{primitive.color.slate.950}",
        "card-dark": "{primitive.color.slate.900}",
        "card-dark-elevated": "{primitive.color.slate.800}",
        "canvas-light": "#ffffff",
        "card-light": "{primitive.color.slate.50}",
        "card-light-elevated": "#ffffff"
      },
      "text": {
        "primary-dark": "{primitive.color.slate.50}",
        "secondary-dark": "{primitive.color.slate.400}",
        "muted-dark": "{primitive.color.slate.500}",
        "primary-light": "{primitive.color.slate.900}",
        "secondary-light": "{primitive.color.slate.600}",
        "muted-light": "{primitive.color.slate.400}"
      },
      "feedback": {
        "success": "{primitive.color.emerald.500}",
        "warning": "{primitive.color.amber.500}",
        "error": "{primitive.color.rose.500}",
        "info": "{primitive.color.blue.500}"
      },
      "border": {
        "subtle-dark": "rgba(255, 255, 255, 0.08)",
        "prominent-dark": "rgba(255, 255, 255, 0.16)",
        "subtle-light": "{primitive.color.slate.200}",
        "prominent-light": "{primitive.color.slate.300}"
      }
    },
    "component": {
      "button": {
        "primary-bg": "{semantic.brand.primary}",
        "primary-hover-bg": "{semantic.brand.primary-hover}",
        "primary-text": "#ffffff",
        "radius": "{primitive.radii.lg}",
        "padding-x": "{primitive.spacing.6}",
        "padding-y": "{primitive.spacing.3}"
      },
      "badge": {
        "ai-bg": "rgba(6, 182, 212, 0.12)",
        "ai-text": "{semantic.brand.accent}",
        "ai-border": "rgba(6, 182, 212, 0.3)"
      },
      "terminal": {
        "bg": "{primitive.color.slate.950}",
        "header-bg": "{primitive.color.slate.900}",
        "border": "rgba(6, 182, 212, 0.2)",
        "text": "{primitive.color.cyan.300}",
        "font": "{primitive.font.mono}"
      }
    }
  }
}
