APP_NAME="FastAPI Backend"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="CHANGE_THIS_SECRET_KEY_FOR_PRODUCTION_MIN_32_CHARS"
LICENSE_HMAC_SECRET="bimauto_telemetry_secure_sign_2026"
# Mount this path on persistent storage. It must match the public key pinned in the add-in.
LICENSE_RSA_PRIVATE_KEY_PATH="/app/data/license_rsa_private.pem"
DATABASE_URL="sqlite+aiosqlite:///./app.db"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
FRONTEND_RESET_URL="http://localhost/reset-password"
# SMTP Email Configuration (Hostinger / Custom)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USERNAME="support@bimautomation.solutions"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_FROM_NAME="BIM Automation"
SMTP_SENDER="BIM Automation <support@bimautomation.solutions>"
SMTP_USE_SSL=True
SMTP_USE_TLS=False
